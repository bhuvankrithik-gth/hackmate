# HackMate server config — copy to .env and fill in
PORT=5000

# Primary MongoDB connection. If unset, falls back to
# mongodb://127.0.0.1:27017/hackmate, then to an in-memory server.
MONGODB_URI=mongodb://127.0.0.1:27017/hackmate

# JWT signing secret (7-day tokens). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth client ID (Web application) for Sign in with Google.
# Create one at https://console.cloud.google.com/apis/credentials
# with authorized JavaScript origins for your frontend origin(s).
GOOGLE_CLIENT_ID=
